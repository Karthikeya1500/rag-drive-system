# ── Required ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Optional: Security ────────────────────────────────────────────────────────
# Set a strong random string to enable API-key authentication.
# Leave blank for open access (dev/local only).
# API_KEY=change_me_to_a_strong_secret

# ── Optional: CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * only in development.
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ── Optional: Server ──────────────────────────────────────────────────────────
# PORT=8000
# WORKERS=2

# ── Optional: LLM ─────────────────────────────────────────────────────────────
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_MAX_TOKENS=1024
# GROQ_MAX_RETRIES=3

# ── Optional: Paths ───────────────────────────────────────────────────────────
# DOWNLOAD_DIR=downloads
# DATA_DIR=data
